# ==============================================================================
# Supabase & PostgreSQL Connection Configuration
# Microsoft Hackathon: Customer Churn & Next-Month Sales Forecasting
# ==============================================================================

# Supabase Project Credentials (Found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL="https://your-project-ref.supabase.co"

# Service Role Key (Recommended for backend pipeline ingestion to bypass RLS)
# Or standard Anon key if public read/write policies are granted
SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# (Optional) Direct PostgreSQL Connection URI (for high-speed psycopg2 batch bulk loading)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Pooler: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres"
